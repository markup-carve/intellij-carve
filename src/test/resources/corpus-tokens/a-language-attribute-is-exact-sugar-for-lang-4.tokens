[ -> text.carve meta.span.inline.carve keyword.control.span.begin.carve
x -> text.carve meta.span.inline.carve string.other.span.carve
] -> text.carve meta.span.inline.carve keyword.control.span.end.carve
{ -> text.carve meta.attributes.carve
#quote -> text.carve meta.attributes.carve entity.other.attribute-name.id.carve
  -> text.carve meta.attributes.carve
:fr -> text.carve meta.attributes.carve entity.other.attribute-name.language.carve
  -> text.carve meta.attributes.carve
.formal -> text.carve meta.attributes.carve entity.other.attribute-name.class.carve
  -> text.carve meta.attributes.carve
title -> text.carve meta.attributes.carve entity.other.attribute-name.carve
= -> text.carve meta.attributes.carve
bonjour -> text.carve meta.attributes.carve string.unquoted.attribute.carve
} -> text.carve meta.attributes.carve
\n -> text.carve
