[ -> source.carve meta.span.inline.carve keyword.control.span.begin.carve
some text -> source.carve meta.span.inline.carve string.other.span.carve
] -> source.carve meta.span.inline.carve keyword.control.span.end.carve
{ -> source.carve meta.attributes.carve
.highlight -> source.carve meta.attributes.carve entity.other.attribute-name.class.carve
  -> source.carve meta.attributes.carve
#note -> source.carve meta.attributes.carve entity.other.attribute-name.id.carve
  -> source.carve meta.attributes.carve
key -> source.carve meta.attributes.carve entity.other.attribute-name.carve
= -> source.carve meta.attributes.carve
val -> source.carve meta.attributes.carve string.unquoted.attribute.carve
} -> source.carve meta.attributes.carve
\n -> source.carve
