[ -> text.carve meta.span.inline.carve keyword.control.span.begin.carve
x -> text.carve meta.span.inline.carve string.other.span.carve
] -> text.carve meta.span.inline.carve keyword.control.span.end.carve
{ -> text.carve meta.attributes.carve
_u -> text.carve meta.attributes.carve entity.other.attribute-name.carve
= -> text.carve meta.attributes.carve
"" -> text.carve meta.attributes.carve string.quoted.double.attribute.carve
} -> text.carve meta.attributes.carve
\n -> text.carve
