H -> source.carve
{, -> source.carve keyword.control.subscript.carve
2 -> source.carve markup.subscript.carve
,} -> source.carve keyword.control.subscript.carve
O and E=mc -> source.carve
{^ -> source.carve keyword.control.superscript.carve
2 -> source.carve markup.superscript.carve
^} -> source.carve keyword.control.superscript.carve
\n -> source.carve
