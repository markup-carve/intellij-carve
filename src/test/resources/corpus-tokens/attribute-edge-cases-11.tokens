[ -> source.carve meta.span.inline.carve keyword.control.span.begin.carve
x -> source.carve meta.span.inline.carve string.other.span.carve
] -> source.carve meta.span.inline.carve keyword.control.span.end.carve
{ -> source.carve meta.attributes.carve
#k -> source.carve meta.attributes.carve entity.other.attribute-name.id.carve
  -> source.carve meta.attributes.carve
.key -> source.carve meta.attributes.carve entity.other.attribute-name.class.carve
 kbd} -> source.carve meta.attributes.carve
\n -> source.carve
