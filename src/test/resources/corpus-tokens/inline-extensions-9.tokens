[ -> text.carve meta.span.inline.carve keyword.control.span.begin.carve
*Ctrl*+C -> text.carve meta.span.inline.carve string.other.span.carve
] -> text.carve meta.span.inline.carve keyword.control.span.end.carve
{ -> text.carve meta.attributes.carve
#copy -> text.carve meta.attributes.carve entity.other.attribute-name.id.carve
  -> text.carve meta.attributes.carve
.shortcut -> text.carve meta.attributes.carve entity.other.attribute-name.class.carve
 kbd  -> text.carve meta.attributes.carve
data-key -> text.carve meta.attributes.carve entity.other.attribute-name.carve
= -> text.carve meta.attributes.carve
"copy" -> text.carve meta.attributes.carve string.quoted.double.attribute.carve
  -> text.carve meta.attributes.carve
onclick -> text.carve meta.attributes.carve entity.other.attribute-name.carve
= -> text.carve meta.attributes.carve
"alert(1)" -> text.carve meta.attributes.carve string.quoted.double.attribute.carve
} -> text.carve meta.attributes.carve
\n -> text.carve
[ -> text.carve meta.span.inline.carve keyword.control.span.begin.carve
x -> text.carve meta.span.inline.carve string.other.span.carve
] -> text.carve meta.span.inline.carve keyword.control.span.end.carve
{kbd  -> text.carve meta.attributes.carve
onclick -> text.carve meta.attributes.carve entity.other.attribute-name.carve
= -> text.carve meta.attributes.carve
"alert(1)" -> text.carve meta.attributes.carve string.quoted.double.attribute.carve
} -> text.carve meta.attributes.carve
