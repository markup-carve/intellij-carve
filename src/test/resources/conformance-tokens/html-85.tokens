a -> source.carve
^[ -> source.carve meta.footnote.inline.carve keyword.control.footnote.carve
x -> source.carve meta.footnote.inline.carve string.other.footnote.inline.carve
] -> source.carve meta.footnote.inline.carve keyword.control.footnote.carve
 and b -> source.carve
[ -> source.carve entity.name.reference.footnote.carve keyword.control.footnote.carve
^ -> source.carve entity.name.reference.footnote.carve keyword.control.footnote.carve
n -> source.carve entity.name.reference.footnote.carve variable.parameter.footnote.carve
] -> source.carve entity.name.reference.footnote.carve keyword.control.footnote.carve
{ -> source.carve meta.attributes.carve
